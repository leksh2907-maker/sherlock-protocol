# Flask
FLASK_DEBUG=False
PORT=5000

# Security — replace both of these with long random strings in production.
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# How long an access token stays valid, in minutes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database — SQLite for local dev (created automatically). For production,
# point this at PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/sherlock
# (requires `pip install psycopg2-binary` — not installed by default)
DATABASE_URL=sqlite:///sherlock.db

# Origin of the frontend allowed to call this API (Vite dev server default)
FRONTEND_ORIGIN=http://localhost:5173
